{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "spellstick-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173,
      "url": "http://localhost:5173"
    },
    {
      "name": "spellstick-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "serve"],
      "port": 8080,
      "autoPort": true
    }
  ]
}
