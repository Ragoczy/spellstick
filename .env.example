# For `npm run dev:swa`. Don't fill this in by hand: run
#   tools/sync-discord-settings.sh local
# which writes .env (git-ignored) from the shared Key Vault without displaying anything.
# Also add http://localhost:4280/api/auth/callback as a redirect on the Darkspace Games Discord app.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_PLAYER_ROLE_IDS=
DISCORD_MODERATOR_ROLE_IDS=
DISCORD_ADMIN_ROLE_IDS=
ADMIN_DISCORD_IDS=
# Spellstick's own (not shared): openssl rand -base64 48
SESSION_SECRET=
# Optional, Spellstick only: allowed roles that replace the shared Players roles (e.g. a beta role).
GAME_ALLOWED_ROLE_IDS=
