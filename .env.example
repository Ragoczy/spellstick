# For `npm run serve`. Don't fill this in by hand: `npm run env:pull` writes .env (git-ignored)
# from the shared Key Vault without displaying anything. The deployed app reads Key Vault directly.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_PLAYER_ROLE_IDS=
DISCORD_MODERATOR_ROLE_IDS=
DISCORD_ADMIN_ROLE_IDS=
ADMIN_DISCORD_IDS=
# This game's own (not shared): openssl rand -base64 48
SESSION_SECRET=
# Optional, this game only: allowed roles that replace the shared Players roles (e.g. a beta role).
GAME_ALLOWED_ROLE_IDS=
# Local port; http://localhost:5190/api/auth/callback is registered on the Discord app.
PORT=5190
